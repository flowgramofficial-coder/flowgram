{
  "name": "flowgram",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm --filter @flowgram/lint lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @flowgram/db generate",
    "db:migrate": "pnpm --filter @flowgram/db migrate",
    "audit:ci": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.0.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0"
    }
  }
}
