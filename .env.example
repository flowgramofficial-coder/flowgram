# Postgres (app traffic goes through PgBouncer; migrations use the direct URL)
DATABASE_URL=postgres://flowgram_app:flowgram_app@localhost:6432/flowgram
DATABASE_DIRECT_URL=postgres://flowgram_owner:flowgram_owner@localhost:5432/flowgram
DATABASE_READ_URL=postgres://flowgram_app:flowgram_app@localhost:6432/flowgram

# Valkey
VALKEY_URL=redis://localhost:6379

# Meta / Instagram
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# Encryption: "local" for dev (LOCAL_KEK_BASE64 = 32 random bytes, base64), "kms" for prod
KEY_PROVIDER=local
LOCAL_KEK_BASE64=
AWS_KMS_KEY_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# AI
ANTHROPIC_API_KEY=
EMBEDDING_API_KEY=

# Web
APP_ORIGIN=http://localhost:3000
AUTH_SECRET=
TURNSTILE_SECRET=

# Free AI Stack (set any of these; Gemini also powers 1536-dim embeddings)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Free Gmail SMTP (use a Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Google Sign-In / Sign-Up OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to "true" ONLY on zero-budget hosts without AWS KMS
ALLOW_LOCAL_KEK=false
