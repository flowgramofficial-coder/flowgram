# Multi-stage build shared by web, webhook-ingestor and worker.
#   docker build -f infra/docker/Dockerfile.node --build-arg APP=webhook-ingestor -t flowgram/ingestor .
ARG NODE_VERSION=26.13.0
FROM node:${NODE_VERSION}-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN npm install -g pnpm@10.28.0
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

FROM deps AS build
ARG APP
RUN pnpm turbo run build --filter=@flowgram/${APP}...
# self-contained, production-only tree for the chosen app
RUN pnpm --filter=@flowgram/${APP} deploy --prod /out

FROM node:${NODE_VERSION}-slim AS runtime
ARG APP
ENV NODE_ENV=production APP=${APP}
WORKDIR /app
COPY --from=build --chown=node:node /out ./
# Next.js output lives in .next (web); the other apps in dist (included by deploy).
USER node
EXPOSE 3000 4000
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||(process.env.APP==='web'?3000:4000))+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" || exit 1
CMD ["sh", "-c", "if [ \"$APP\" = web ]; then exec node_modules/.bin/next start; else exec node dist/$([ \"$APP\" = worker ] && echo main || echo server).js; fi"]
